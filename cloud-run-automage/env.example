# Copy this file to .env and edit locally. Do not commit .env.

# Required Google Cloud settings
GCP_PROJECT=your-project-id
GCP_REGION=us-east4

# Demo/input imagery. The API always uses this URI for now.
INPUT_TIF_URI=gs://your-input-bucket/path/demo.tif

# Output destination. Users provide only output_prefix in the request body.
OUTPUT_BUCKET=your-output-bucket
OUTPUT_FOLDER=output_folder

# Cloud Run / Artifact Registry names
API_SERVICE_NAME=cwcb-landcover-api
WORKER_JOB_NAME=cwcb-landcover-worker
ARTIFACT_REPOSITORY=cwcb-landcover

# SAM3 model weights are not committed. Worker builds download these two files
# from this folder: model-00001-of-00002.safetensors and model-00002-of-00002.safetensors.
SAM3_WEIGHTS_GCS_URI=gs://your-model-bucket/automage/sam3

# Optional service accounts. Leave blank to use gcloud defaults.
# BUILD_SERVICE_ACCOUNT is used only for gcloud builds submit.
# RUNTIME_SERVICE_ACCOUNT is attached to both the Cloud Run API service and worker job.
BUILD_SERVICE_ACCOUNT=cwcb-cloudbuild@your-project-id.iam.gserviceaccount.com
RUNTIME_SERVICE_ACCOUNT=cwcb-landcover-runtime@your-project-id.iam.gserviceaccount.com

# Worker runtime
GPU_TYPE=nvidia-l4
WORKER_CPU=8
WORKER_MEMORY=32Gi
WORKER_TIMEOUT=3600s
